{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "bash": "ask",
        "edit": "allow",
        "webfetch": "allow"
    },
    "plugin": ["@sveltejs/opencode", "@warp-dot-dev/opencode-warp"],
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": false
        },
        "medusa": {
            "type": "remote",
            "url": "https://docs.medusajs.com/mcp",
            "enabled": false
        },
        "chrome-devtools": {
            "type": "local",
            "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
            "enabled": false
        }
    }
}
