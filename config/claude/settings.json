{
    "model": "opus",
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "atuin hook claude-code"
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "atuin hook claude-code"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "atuin hook claude-code"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash '/Users/damitzi/.claude/hooks/herdr-agent-state.sh' session",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "bash '/Users/damitzi/.dotfiles/config/claude/statusline.sh'"
    },
    "enabledPlugins": {
        "warp@claude-code-warp": true
    },
    "extraKnownMarketplaces": {
        "claude-code-warp": {
            "source": {
                "source": "github",
                "repo": "warpdotdev/claude-code-warp"
            }
        }
    },
    "effortLevel": "high",
    "skipDangerousModePermissionPrompt": true,
    "theme": "auto",
    "inputNeededNotifEnabled": true,
    "agentPushNotifEnabled": true,
    "disableArtifact": true
}
